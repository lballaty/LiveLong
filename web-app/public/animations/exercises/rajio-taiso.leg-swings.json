            "handL.hold": 1,
            "shoulderL.flex": 20,
            "shoulderL.abd": 10,
            "elbowL.flex": 35,
            "forearmL.pron": 80,
            "handR.hold": 1,
            "shoulderR.flex": 20,
            "shoulderR.abd": 10,
            "elbowR.flex": 35,
            "forearmR.pron": 80,
            "pelvis.x": 0,
            "pelvis.y": 0,
            "hipL.flex": 0,
            "hipL.abd": 0,
            "kneeL.flex": 0,
            "ankleL.dorsi": 0
          }
        }
