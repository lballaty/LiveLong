{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:animation:schema:bundle-manifest:1",
  "title": "Bundle manifest",
  "description": "Index of an exported bundle: versions, contents, what was left out and why, and a sha256 checksum for every file except the manifest itself.",
  "type": "object",
  "required": ["kind", "formatVersion", "bundle", "version", "status", "createdAt", "source", "runtime", "minRuntimeVersion", "defaultCharacter", "exercises", "characters", "excluded", "limitations", "files"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "bundle-manifest" },
    "formatVersion": { "const": 1 },
    "bundle": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)?$", "description": "A series (whole bundle) or a single <series>.<step> pack id" },
    "version": { "$ref": "#/$defs/semver" },
    "status": { "enum": ["draft", "released"] },
    "note": { "type": "string" },
    "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": {
      "type": "object",
      "required": ["repo", "commit", "dirty"],
      "additionalProperties": false,
      "properties": {
        "repo": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "dirty": { "type": "boolean", "description": "Uncommitted changes to tracked source files existed at export time" }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["file", "types", "version"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "types": { "type": "string" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "minRuntimeVersion": { "$ref": "#/$defs/semver" },
    "defaultCharacter": { "type": "string" },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "file", "title", "variants", "views"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "version": { "$ref": "#/$defs/semver" },
          "file": { "type": "string" },
          "livelongStepId": { "type": "string" },
          "title": { "type": "string" },
          "variants": { "type": "array", "items": { "enum": ["standing", "chair"] }, "minItems": 1, "uniqueItems": true },
          "views": { "type": "array", "items": { "enum": ["front", "side"] }, "minItems": 1, "uniqueItems": true }
        }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "file", "label", "approval"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "version": { "$ref": "#/$defs/semver" },
          "file": { "type": "string" },
          "label": { "type": "string" },
          "approval": { "enum": ["approved", "pending-review"] }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "reason": { "type": "string", "minLength": 1 } }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "bytes"],
        "additionalProperties": false,
        "properties": {
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    }
  }
}
